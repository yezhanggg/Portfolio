---
import "../styles/fonts.css";
import "../styles/site.css";

const { title, description, image, noChat = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <script is:inline>
      // Scale the fixed-width canvases (980 desktop / 320 phone) to the viewport before first paint.
      // On a laptop every page keeps the proportions it has at 1440 x 900, whatever the screen: --z
      // scales the canvases with whichever of width and height is tighter, and --uz (never below 1)
      // lets the ordinary responsive pages grow on larger screens. Phones are laid out separately.
      (function () {
        function fit() {
          var d = document.documentElement, w = d.clientWidth, h = innerHeight;
          var lap = Math.min(w / 1440, h / 900);
          var z = w < 750 ? w / 320 : Math.min(w / 980, Math.max(0.7, lap));
          d.style.setProperty("--z", z);
          d.style.setProperty("--uz", w < 750 ? 1 : Math.max(1, lap));
        }
        fit();
        addEventListener("resize", fit);
      })();
    </script>
  </head>
  <body>
    <slot />
    {!noChat && <script src="/widget.js" defer is:inline></script>}
  </body>
</html>

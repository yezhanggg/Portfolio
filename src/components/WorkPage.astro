---
// A product page under /work, reached from SELECTED WORK on /professional. Same type and manners
// as that page: the site's grotesk, letter-spaced capitals, monospace for small facts, hairlines,
// black on white; the product's own screenshots are the only colour. It opens on the product's
// three cards (the ones that fly out of its row on /professional) dealt into a fan.
//
// Images are /media WebP sets: `src` names the set, `w` its widths (e.g. ["1200", "2000"]).
import Base from "../layouts/Base.astro";

const { p } = Astro.props;
const set = (img) => img.w.map((w) => `${img.src}-${w}.webp ${w}w`).join(", ");
const first = (img) => `${img.src}-${img.w[0]}.webp`;
---

<Base title={`${p.title.toUpperCase()} | YE'SOLUTION`} description={p.summary} image={first(p.cards[0])}>
  <div class="wk" style={`--accent: ${p.accent}`}>
    <nav class="wk-top" aria-label="Site">
      <a class="wk-mark" href="/professional#work">YE'SOLUTION</a>
      <a class="wk-back" href="/professional#work">BACK</a>
      <span class="wk-count" aria-hidden="true">{p.index}</span>
    </nav>

    <header class="wk-head">
      <p class="wk-kicker rise" style="--i: 0">SELECTED WORK<span aria-hidden="true"> · </span>{p.year}</p>
      <h1 class="rise" style="--i: 1">{p.title}</h1>
      <p class="wk-tag rise" style="--i: 2">{p.tagline[0]} {p.tagline[1] && <em>{p.tagline[1]}</em>}</p>
      <dl class="wk-meta rise" style="--i: 3">
        {p.meta.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      {p.links?.length > 0 && (
        <p class="wk-links rise" style="--i: 4">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              <span class="u">{l.label}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5l7-7M6 4.5h5.5V10" /></svg>
            </a>
          ))}
        </p>
      )}
      {p.note && <p class="wk-note rise" style="--i: 4">{p.note}</p>}
    </header>

    <figure class="wk-deck" aria-label={p.cards[0].alt}>
      {p.cards.map((c, i) => (
        <img class={`card c${i}`} src={first(c)} srcset={set(c)} sizes="(min-width: 980px) 760px, 86vw" alt={i ? "" : c.alt} decoding="async" fetchpriority={i ? "auto" : "high"} />
      ))}
    </figure>

    <main class="wk-body">
      <section class="wk-sec reveal">
        <h2 class="wk-label">THE QUESTION</h2>
        <div class="wk-col">
          <p class="wk-lead">{p.question}</p>
          {p.answer && <p class="wk-text">{p.answer}</p>}
        </div>
      </section>

      <section class="wk-sec">
        <h2 class="wk-label reveal">WHAT IT DOES</h2>
        <ol class="wk-col wk-feats">
          {p.features.map((f, i) => (
            <li class="wk-feat reveal">
              <div class="wk-feat-text">
                <span class="wk-num">{String(i + 1).padStart(2, "0")}</span>
                <h3>{f.title}</h3>
                <p class="wk-text">{f.text}</p>
              </div>
              {f.image && (
                <img class="wk-shot" src={first(f.image)} srcset={set(f.image)} sizes="(min-width: 980px) 820px, 92vw" alt={f.image.alt} loading="lazy" decoding="async" />
              )}
            </li>
          ))}
        </ol>
      </section>

      <section class="wk-sec reveal">
        <h2 class="wk-label">IN NUMBERS</h2>
        <dl class="wk-col wk-nums">
          {p.numbers.map(([v, k]) => (
            <div>
              <dt>{v}</dt>
              <dd>{k}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="wk-sec reveal">
        <h2 class="wk-label">{p.principlesLabel || "PRINCIPLES"}</h2>
        <ul class="wk-col wk-quotes">
          {p.principles.map((q) => <li>{q}</li>)}
        </ul>
      </section>

      <section class="wk-sec reveal">
        <h2 class="wk-label">{p.sourcesLabel || "DATA"}</h2>
        <ul class="wk-col wk-sources">
          {p.sources.map((s) => <li>{s}</li>)}
        </ul>
      </section>
    </main>

    <footer class="wk-foot">
      <a class="wk-next" href={p.next.href}>
        <span class="wk-label">NEXT</span>
        <span class="wk-next-title"><span class="u">{p.next.title}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M9 3.5L13.5 8 9 12.5" /></svg></span>
      </a>
      <p class="wk-end">
        <a class="label" href="/professional#work">BACK TO YE'SOLUTION</a>
        <span>©2021-2026 YeZhang</span>
      </p>
    </footer>
  </div>
</Base>

<script>
  // Sections come up as they scroll into view (once).
  const items = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))),
      { rootMargin: "0px 0px -8% 0px" },
    );
    items.forEach((el) => io.observe(el));
  } else items.forEach((el) => el.classList.add("in"));
</script>

<style>
  :global(body) {
    background: #fff;
  }
  .wk {
    --gut: 48px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--gut) 72px;
    zoom: var(--uz, 1); /* larger laptops: the whole page grows with the screen (Base.astro) */
    font-family: "dinneuzeitgroteskltw01-_812426", sans-serif;
    color: #000;
  }
  .wk a {
    color: inherit;
    text-decoration: none;
  }
  /* (in :where, so any class below can set its own margins) */
  :where(.wk) :where(h1, h2, h3, p, dl, dd, ul, ol, figure) {
    margin: 0;
    padding: 0;
    font-weight: normal;
  }
  :where(.wk) :where(ul, ol) {
    list-style: none;
  }

  /* ---- Top: the side's name, BACK in the middle (as on the portfolio), the count ---- */
  .wk-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 28px 0;
    font-size: 12px;
    letter-spacing: 0.3em;
  }
  .wk-back {
    font-size: 14px;
    letter-spacing: 0.2em;
  }
  .wk-count {
    justify-self: end;
    font: 12px/1 ui-monospace, "SF Mono", Menlo, monospace;
    letter-spacing: 0.08em;
    color: #9a9a9a;
  }
  .wk-mark,
  .wk-back,
  .label {
    text-decoration: underline 1px transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.3s ease, color 0.2s ease;
  }
  .wk-mark:hover,
  .wk-back:hover,
  .label:hover,
  .wk-mark:focus-visible,
  .wk-back:focus-visible,
  .label:focus-visible {
    text-decoration-color: currentColor;
    outline: none;
  }

  /* ---- Head ---- */
  .wk-head {
    padding: 88px 0 64px;
  }
  .wk-kicker {
    font-size: 12px;
    letter-spacing: 0.3em;
    color: #767676;
  }
  .wk h1 {
    margin-top: 22px;
    font-size: clamp(54px, 10.5vw, 148px);
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .wk-tag {
    max-width: 760px;
    margin-top: 30px;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.25;
  }
  .wk-tag em {
    font-style: normal;
    color: var(--accent);
  }
  .wk-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 40px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid #e5e5e5;
  }
  .wk-meta dt,
  .wk-label {
    font-size: 12px;
    letter-spacing: 0.3em;
    color: #767676;
  }
  .wk-meta dd {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.45;
  }
  /* the product's links: buttons in its own colour (VisionPitts violet) */
  .wk-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 44px;
    font-size: 14px;
    letter-spacing: 0.16em;
  }
  .wk .wk-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 22px 0 24px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 24px -12px var(--accent);
    transition: transform 0.25s var(--ease), box-shadow 0.25s ease, filter 0.2s ease;
  }
  .wk .wk-links a:hover,
  .wk .wk-links a:focus-visible {
    transform: translateY(-2px);
    filter: brightness(0.92);
    box-shadow: 0 16px 30px -14px var(--accent);
  }
  .wk .wk-links a:active {
    transform: none;
  }
  .wk-links .u {
    background: none;
  }
  .wk-links svg,
  .wk-next svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    transition: transform 0.3s var(--ease);
  }
  .wk-links a:hover svg,
  .wk-links a:focus-visible svg {
    transform: translate(2px, -2px);
  }
  .wk-note {
    margin-top: 40px;
    font: 12px/1.6 ui-monospace, "SF Mono", Menlo, monospace;
    color: #767676;
  }
  /* the underline draws across */
  .u {
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    padding-bottom: 2px;
    transition: background-size 0.35s var(--ease);
  }
  a:hover .u,
  a:focus-visible .u {
    background-size: 100% 1px;
  }
  a:focus-visible {
    outline: none;
  }

  /* ---- The deck: three cards dealt into a fan ---- */
  .wk-deck {
    position: relative;
    width: min(760px, 86%);
    aspect-ratio: 16 / 10;
    margin: 24px auto 136px;
  }
  .card {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
    background: #f1f1f1;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.05);
    animation: deal 1.1s var(--ease) both;
  }
  .c0 {
    z-index: 3;
    animation-delay: 0.35s;
  }
  .c1 {
    z-index: 2;
    --to: translate(-24%, 7%) rotate(-7deg) scale(0.84);
    transform: var(--to);
    animation-delay: 0.5s;
  }
  .c2 {
    z-index: 1;
    --to: translate(24%, 7%) rotate(7deg) scale(0.84);
    transform: var(--to);
    animation-delay: 0.6s;
  }
  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(18%) scale(0.86);
    }
    to {
      opacity: 1;
      transform: var(--to, none);
    }
  }

  /* ---- Body: a label column and the content ---- */
  .wk-sec {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 28px;
    padding: 64px 0 88px;
    border-top: 1px solid #e5e5e5;
  }
  .wk-label {
    position: sticky;
    top: 28px;
    align-self: start;
  }
  .wk-lead {
    max-width: 780px;
    font-size: clamp(24px, 2.7vw, 34px);
    line-height: 1.3;
  }
  .wk-text {
    max-width: 640px;
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.6;
    color: #4a4a4a;
  }
  .wk-feats {
    display: grid;
    row-gap: 96px;
  }
  .wk-feat-text {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 12px;
    max-width: 700px;
  }
  .wk-feat-text .wk-text {
    grid-column: 2;
    margin-top: 10px;
  }
  .wk-num {
    padding-top: 7px;
    font: 12px/1 ui-monospace, "SF Mono", Menlo, monospace;
    color: #9a9a9a;
  }
  .wk h3 {
    font-size: 26px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .wk-shot {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 32px;
    border-radius: 12px;
    background: #f4f4f4;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.07), 0 24px 48px -28px rgba(0, 0, 0, 0.3);
  }
  .wk-nums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 52px 48px;
  }
  .wk-nums dt {
    font-size: clamp(48px, 6vw, 84px);
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }
  .wk-nums dd {
    max-width: 300px;
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.5;
    color: #4a4a4a;
  }
  .wk-quotes li {
    max-width: 780px;
    padding: 26px 0;
    border-bottom: 1px solid #ededed;
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.35;
  }
  .wk-quotes li:first-child {
    padding-top: 0;
  }
  .wk-sources {
    columns: 2;
    column-gap: 48px;
    font: 13px/1.6 ui-monospace, "SF Mono", Menlo, monospace;
    color: #4a4a4a;
  }
  .wk-sources li {
    break-inside: avoid;
    padding: 0 0 12px;
  }

  /* ---- Foot ---- */
  .wk-foot {
    padding-top: 64px;
    border-top: 1px solid #000;
  }
  .wk-next {
    display: grid;
    gap: 18px;
  }
  .wk-next-title {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1;
    text-transform: uppercase;
  }
  .wk-next-title svg {
    width: clamp(28px, 4vw, 56px);
    height: clamp(28px, 4vw, 56px);
    stroke-width: 1.1;
  }
  .wk-next:hover svg,
  .wk-next:focus-visible svg {
    transform: translateX(8px);
  }
  .wk-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px 40px;
    margin-top: 96px;
    font-size: 13px;
    letter-spacing: 0.16em;
  }
  .wk-end span {
    color: #9a9a9a;
  }

  /* ---- Arrivals ---- */
  .rise {
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(0.08s * var(--i, 0));
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s ease, transform 1s var(--ease);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .rise,
    .card {
      animation: none;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---- Narrow windows and phones ---- */
  @media (max-width: 979px) {
    .wk {
      --gut: 20px;
    }
    .wk-top {
      padding: 20px 0;
    }
    .wk-head {
      padding: 56px 0 44px;
    }
    .wk-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wk-deck {
      margin-bottom: 96px;
    }
    .wk-sec {
      grid-template-columns: minmax(0, 1fr);
      padding: 44px 0 64px;
    }
    .wk-label {
      position: static;
    }
    .wk-feats {
      row-gap: 72px;
    }
    .wk-nums {
      gap: 36px 24px;
    }
    .wk-sources {
      columns: 1;
    }
  }
  @media (max-width: 560px) {
    .wk-mark {
      font-size: 10px;
      letter-spacing: 0.2em;
    }
    .wk-meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .wk-feat-text {
      grid-template-columns: 32px minmax(0, 1fr);
    }
    .wk h3 {
      font-size: 21px;
    }
  }
</style>

---
// Renders one positioned node from the extracted page data. Coordinates are canvas pixels
// (980 wide on desktop, 320 on phones); `origin` shifts children of a slideshow slide.
import { css, px, localHref, isExternal, rewriteLinks, fontFix, maskCss, mediaFor, parseTransform, srcset, largest, smallest } from "../lib/site.js";

const { node: n, canvas, origin = [0, 0], inSlide = false } = Astro.props;
const [x, y, w, h] = [n.box[0] - origin[0], n.box[1] - origin[1], n.box[2], n.box[3]];
const bleed = n.bleed && !inSlide;
const frame = {
  left: bleed ? undefined : px(x),
  top: px(y),
  width: bleed ? undefined : px(w),
  height: px(h),
  transform: n.rotate ? `rotate(${n.rotate}deg)` : undefined,
};
const visibleShadow = (s) => (s && !/rgba\([^)]*,\s*0\)/.test(s) ? s : undefined);
// Wix divider lines are thin boxes with only a top border.
const thinLine = n.type === "box" && n.border && !n.bg && Math.min(n.box[2], n.box[3]) <= 10;
const paint = {
  background: n.bgImage || n.bg,
  // Bordered buttons on the old site were menu tabs with a rule above and below.
  border: n.line || thinLine || n.type === "button" ? undefined : n.border,
  "border-top": (n.line || thinLine || n.type === "button") && parseFloat(n.border) > 0 ? n.border : undefined,
  "border-bottom": n.type === "button" && parseFloat(n.border) > 0 ? n.border : undefined,
  "border-left": n.line && parseFloat(n.borderLeft) > 0 ? n.borderLeft : undefined,
  "border-radius": n.radius,
  "box-shadow": visibleShadow(n.shadow),
  opacity: n.opacity,
};
const href = localHref(n.href);
const linkAttrs = href ? { href, ...(isExternal(href) ? { target: "_blank", rel: "noopener" } : {}) } : {};
const sizes = (cssW) => (canvas === 320 ? `${Math.min(100, Math.ceil((cssW / 320) * 100))}vw` : `${Math.ceil(cssW)}px`);
const eager = n.box[1] < 900 && !inSlide;

// --- image geometry ---
let img = null;
if (n.type === "image") {
  const m = mediaFor(n.src);
  if (m) {
    const t = parseTransform(n.src);
    let style, shownW = w;
    if (t.crop && m.w) {
      const [cx, cy, cw, ch] = t.crop;
      const s = Math.max(w / cw, h / ch);
      shownW = m.w * s;
      style = css({ position: "absolute", width: px(m.w * s), height: px(m.h * s), left: px(-cx * s - (cw * s - w) / 2), top: px(-cy * s - (ch * s - h) / 2), "max-width": "none" });
    } else {
      const fit = t.mode === "fit" ? "contain" : n.fit && n.fit !== "fill" ? n.fit : "cover";
      const pos = { t: "top", b: "bottom", l: "left", r: "right" }[t.align] || (n.position && n.position !== "50% 50%" ? n.position : undefined);
      style = css({ width: "100%", height: "100%", "object-fit": fit, "object-position": pos });
    }
    img = { m, style, shownW };
  }
}
const labelPos = (n) =>
  n.labelBox
    ? css({ left: px(n.labelBox[0] + n.labelBox[2] / 2 - n.box[0]), top: px(n.labelBox[1] + n.labelBox[3] / 2 - n.box[1]), ...fontFix(n.style), "text-align": undefined })
    : css({ left: "50%", top: "50%", ...fontFix(n.style) });
const Tag = n.type === "button" ? (href ? "a" : n.submit ? "button" : "div") : "div";
---

{n.type === "box" && <div class:list={["n", { bleed }]} style={css({ ...frame, ...paint })} />}

{n.type === "text" && (
  <div class:list={["n", "t", { bleed, nw: n.lines === 1 }]} style={css({ ...frame, height: undefined, "min-height": frame.height, ...fontFix(n.style) })} set:html={rewriteLinks(n.html)} />
)}

{n.type === "button" && (
  <Tag class:list={["n", "btn", { bleed }]} style={css({ ...frame, ...paint })} {...(Tag === "a" ? linkAttrs : {})} {...(Tag === "button" ? { type: "submit" } : {})}>
    {n.label ? <span class="lbl" style={labelPos(n)}>{n.label}</span> : n.icon ? <Fragment set:html={n.icon} /> : null}
  </Tag>
)}

{n.type === "image" && img && (
  href ? (
    <a class:list={["n", "img", { bleed }]} style={css({ ...frame, "border-radius": n.radius, opacity: n.opacity, ...maskCss(n.mask) })} {...linkAttrs}>
      <img src={smallest(img.m)} srcset={srcset(img.m)} sizes={sizes(img.shownW)} alt={n.alt || ""} style={img.style} loading={eager ? "eager" : "lazy"} decoding="async" />
    </a>
  ) : (
    <div class:list={["n", "img", { bleed }]} style={css({ ...frame, "border-radius": n.radius, opacity: n.opacity, ...maskCss(n.mask) })}>
      <img src={smallest(img.m)} srcset={srcset(img.m)} sizes={sizes(img.shownW)} alt={n.alt || ""} style={img.style} loading={eager ? "eager" : "lazy"} decoding="async" />
    </div>
  )
)}

{n.type === "svg" && (
  href ? (
    <a class="n svg" style={css({ ...frame, fill: n.fill, color: n.color })} {...linkAttrs} aria-label={n.label} set:html={n.html} />
  ) : (
    <div class="n svg" style={css({ ...frame, fill: n.fill, color: n.color })} set:html={n.html} />
  )
)}

{n.type === "video" && n.file && (
  <video
    class:list={["n", "vid", { bleed }]}
    style={css({ ...frame, "object-fit": n.fit && n.fit !== "fill" ? n.fit : "cover", ...maskCss(n.mask), background: n.mask ? "none" : undefined })}
    src={n.file}
    poster={n.posterFile}
    playsinline
    preload={n.autoplay ? "auto" : "none"}
    {...(n.autoplay ? { autoplay: true, muted: true, loop: true } : { controls: true })}
  />
)}

{n.type === "iframe" && n.src && (
  <iframe class:list={["n", { bleed }]} data-yt-frame={n.yt} style={css({ ...frame, border: "0" })} src={n.src} title={n.title || ""} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen />
)}

{n.type === "gallery" && (() => {
  const minX = Math.min(...n.items.map((i) => i.box[0]));
  const maxX = Math.max(...n.items.map((i) => i.box[0] + i.box[2]));
  const maxY = Math.max(...n.items.map((i) => i.box[1] + i.box[3]));
  const scrolls = maxX - minX > w + 2;
  return (
    <div class:list={["n", "gal", { bleed, scrolls }]} style={css({ ...frame, height: px(Math.max(h, maxY)) })} data-start={scrolls ? Math.max(0, -minX) : undefined}>
      <div class="gal-inner" style={css({ width: px(maxX - minX), height: px(maxY) })}>
        {n.items.map((it) => {
          const m = mediaFor(it.src);
          return m && (
            <a class="gal-item" href={largest(m)} data-pswp-width={m.w} data-pswp-height={m.h} target="_blank" style={css({ left: px(it.box[0] - minX), top: px(it.box[1]), width: px(it.box[2]), height: px(it.box[3]) })}>
              <img src={smallest(m)} srcset={srcset(m)} sizes={sizes(it.box[2])} alt={it.alt || ""} loading="lazy" decoding="async" />
            </a>
          );
        })}
      </div>
    </div>
  );
})()}

{n.type === "slideshow" && (
  <div class:list={["n", "show", { bleed }]} style={css(frame)} data-slideshow>
    {n.slides.map((slide, i) => (
      <div class:list={["slide", { on: i === 0 }]} aria-hidden={i === 0 ? undefined : "true"}>
        {slide.map((child) => <Astro.self node={child} canvas={canvas} origin={[n.box[0], n.box[1]]} inSlide />)}
      </div>
    ))}
    {n.slides.length > 1 && (
      <Fragment>
        <button type="button" class="show-nav prev" aria-label="Previous" style={n.prev ? css({ left: px(n.prev[0] - n.box[0] - 15), top: px(n.prev[1] - n.box[1] - 15), color: n.arrowColor }) : "left:0;top:calc(50% - 26px)"}>
          <svg viewBox="0 0 10 20" width="10" height="20"><path d="M9 1 1 10l8 9" fill="none" stroke="currentColor" stroke-width="1" /></svg>
        </button>
        <button type="button" class="show-nav next" aria-label="Next" style={n.next ? css({ left: px(n.next[0] - n.box[0] - 15), top: px(n.next[1] - n.box[1] - 15), color: n.arrowColor }) : "right:0;top:calc(50% - 26px)"}>
          <svg viewBox="0 0 10 20" width="10" height="20"><path d="m1 1 8 9-8 9" fill="none" stroke="currentColor" stroke-width="1" /></svg>
        </button>
        {n.dots && (
          <div class="show-dots" style={css({ left: px(n.dots.first[0] - n.box[0]), top: px(n.dots.first[1] - n.box[1]), gap: px(Math.max(0, n.dots.step - n.dots.first[2])), "--dot": n.dots.idle, "--dot-on": n.dots.active })}>
            {n.slides.map((_, i) => <button type="button" class:list={["dot", { on: i === 0 }]} aria-label={`Slide ${i + 1}`} style={css({ width: px(n.dots.first[2]), height: px(n.dots.first[3]) })} />)}
          </div>
        )}
      </Fragment>
    )}
  </div>
)}

{n.type === "input" && (n.inputType === "checkbox" || n.inputType === "radio") && (
  <label class="n chk" style={css({ ...frame, ...fontFix(n.labelStyle) })}>
    <input type={n.inputType} name={n.key} value={n.value} />
    <span>{n.label}</span>
  </label>
)}

{n.type === "input" && n.inputType !== "checkbox" && n.inputType !== "radio" && (
  <Fragment>
    {n.label && n.labelBox && <label class="n lab" for={n.fieldId} style={css({ left: px(n.labelBox[0] - origin[0]), top: px(n.labelBox[1] - origin[1]), width: px(n.labelBox[2]), ...n.labelStyle })}>{n.label}</label>}
    {n.tag === "textarea" ? (
      <textarea class="n inp" id={n.fieldId} name={n.key} placeholder={n.placeholder?.trim()} required={n.required} aria-label={n.label || n.placeholder?.trim()} style={css({ ...frame, ...fontFix(n.style), background: n.bg || "transparent", border: n.border || "0", "border-bottom": n.borderBottom, "border-radius": n.radius, "box-shadow": visibleShadow(n.shadow), padding: n.padding, "--ph": n.placeholderColor })} />
    ) : (
      <input class="n inp" id={n.fieldId} type={n.inputType} name={n.key} placeholder={n.placeholder?.trim()} required={n.required} aria-label={n.label || n.placeholder?.trim()} style={css({ ...frame, ...fontFix(n.style), background: n.bg || "transparent", border: n.border || "0", "border-bottom": n.borderBottom, "border-radius": n.radius, "box-shadow": visibleShadow(n.shadow), padding: n.padding, "--ph": n.placeholderColor })} />
    )}
  </Fragment>
)}

{n.type === "ytthumb" && (
  <a class="n img yt" style={css(frame)} href={`https://www.youtube.com/watch?v=${n.vid}`} data-yt={n.vid} target="_blank" rel="noopener">
    <img src={`/media/yt-${n.vid}.jpg`} alt={n.alt || ""} style="width:100%;height:100%;object-fit:cover" loading="lazy" decoding="async" />
  </a>
)}
